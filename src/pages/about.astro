---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout pageTitle="About — Portfolio" description="About Adwik Pandey.">
	<section class="card pad">
		<span class="badge">About</span>
		<h1 class="h1" style="margin-top:12px;">I build ML that ships as a usable system.</h1>
		<p class="p">
			I like projects where the result is interactive and responsive. I care about clean implementation, measurable
			outcomes, and presentation that makes the work easy to understand.
		</p>

		<section class="grid" style="margin-top:16px;">
			<div class="card pad col7" style="background: var(--panel2); box-shadow:none;">
				<h2 class="h2">Focus areas</h2>
				<div class="pillrow">
					<span class="pill">Computer Vision</span>
					<span class="pill">ML pipelines</span>
					<span class="pill">Real-time inference</span>
					<span class="pill">Applied projects</span>
				</div>
			</div>

			<div class="card pad col5" style="background: var(--panel2); box-shadow:none;">
				<h2 class="h2">Currently</h2>
				<p class="p">Preparing for internships and expanding my portfolio with practical AI/ML projects.</p>
			</div>
		</section>
	</section>
</BaseLayout>