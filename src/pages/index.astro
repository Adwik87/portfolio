---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout pageTitle="Welcome — Portfolio" description="Welcome page for Adwik Pandey's AI/ML portfolio.">
	<section class="card pad">
		<div class="hero">
			<div>
				<span class="badge">Welcome</span>
				<h1 class="h1" style="margin-top:12px;">A focused AI/ML portfolio built for internships.</h1>
				<p class="p">
					Selected projects with clean, case-study style write-ups. Designed to be fast, elegant, and easy to scan.
				</p>

				<div class="btnrow">
					<a class="btn primary" href="/home">Begin</a>
					<a class="btn ghost" href="/projects">View projects</a>
				</div>

				<div class="pillrow">
					<span class="pill">Computer Vision</span>
					<span class="pill">Machine Learning</span>
					<span class="pill">Real-time systems</span>
				</div>
			</div>

			<img class="heroImg" src="/images/portrait.jpg" alt="Portrait" />
		</div>
	</section>
</BaseLayout>